// คำอธิบายสำหรับผู้เริ่มต้น
// ภาพรวมไฟล์: เป็นพิมพ์เขียวฐานข้อมูลหลักของ Nestly ซึ่งกำหนดตาราง ฟิลด์ ความสัมพันธ์ ดัชนี และชนิดสถานะทั้งหมด
// การทำงาน: Prisma อ่านไฟล์นี้เพื่อสร้างตัวช่วย TypeScript และ migration; เมื่อเปลี่ยนโครงสร้างต้องสร้าง migration ใหม่ ห้ามแก้ migration เก่าที่ใช้งานแล้ว

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// คำอธิบายก้อนโค้ดสำหรับผู้เริ่มต้น
/// กลุ่มสถานะ DocumentKind: จำกัดค่าที่ฐานข้อมูลยอมรับ เพื่อไม่ให้บันทึกข้อความสถานะที่สะกดหรือมีความหมายไม่ตรงกัน
enum DocumentKind {
  CONTRACT
  INVOICE
}

/// คำอธิบายก้อนโค้ดสำหรับผู้เริ่มต้น
/// กลุ่มสถานะ UserRole: จำกัดค่าที่ฐานข้อมูลยอมรับ เพื่อไม่ให้บันทึกข้อความสถานะที่สะกดหรือมีความหมายไม่ตรงกัน
enum UserRole {
  SUPER_ADMIN
  PROPERTY_ADMIN
  TENANT
}

/// คำอธิบายก้อนโค้ดสำหรับผู้เริ่มต้น
/// กลุ่มสถานะ AccountApprovalStatus: จำกัดค่าที่ฐานข้อมูลยอมรับ เพื่อไม่ให้บันทึกข้อความสถานะที่สะกดหรือมีความหมายไม่ตรงกัน
enum AccountApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// คำอธิบายก้อนโค้ดสำหรับผู้เริ่มต้น
/// กลุ่มสถานะ AuditResult: จำกัดค่าที่ฐานข้อมูลยอมรับ เพื่อไม่ให้บันทึกข้อความสถานะที่สะกดหรือมีความหมายไม่ตรงกัน
enum AuditResult {
  SUCCESS
  FAILURE
}

/// คำอธิบายก้อนโค้ดสำหรับผู้เริ่มต้น
/// กลุ่มสถานะ ChatSenderRole: จำกัดค่าที่ฐานข้อมูลยอมรับ เพื่อไม่ให้บันทึกข้อความสถานะที่สะกดหรือมีความหมายไม่ตรงกัน
enum ChatSenderRole {
  ADMIN
  TENANT
  SUPER_ADMIN
}

/// คำอธิบายก้อนโค้ดสำหรับผู้เริ่มต้น
/// กลุ่มสถานะ ChatConversationType: จำกัดค่าที่ฐานข้อมูลยอมรับ เพื่อไม่ให้บันทึกข้อความสถานะที่สะกดหรือมีความหมายไม่ตรงกัน
enum ChatConversationType {
  TENANT_PROPERTY
  PROPERTY_SUPPORT
}

/// คำอธิบายก้อนโค้ดสำหรับผู้เริ่มต้น
/// กลุ่มสถานะ SubscriptionStatus: จำกัดค่าที่ฐานข้อมูลยอมรับ เพื่อไม่ให้บันทึกข้อความสถานะที่สะกดหรือมีความหมายไม่ตรงกัน
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
}

/// คำอธิบายก้อนโค้ดสำหรับผู้เริ่มต้น
/// กลุ่มสถานะ BillingInterval: จำกัดค่าที่ฐานข้อมูลยอมรับ เพื่อไม่ให้บันทึกข้อความสถานะที่สะกดหรือมีความหมายไม่ตรงกัน
enum BillingInterval {
  MONTHLY
  YEARLY
}

/// คำอธิบายก้อนโค้ดสำหรับผู้เริ่มต้น
