enum SubscriptionOrderType {
  NEW
  RENEWAL
}

/// คำอธิบายก้อนโค้ดสำหรับผู้เริ่มต้น
/// กลุ่มสถานะ SubscriptionOrderStatus: จำกัดค่าที่ฐานข้อมูลยอมรับ เพื่อไม่ให้บันทึกข้อความสถานะที่สะกดหรือมีความหมายไม่ตรงกัน
enum SubscriptionOrderStatus {
  PENDING_PAYMENT
  PENDING_REVIEW
  PAID
  REJECTED
  CANCELLED
  EXPIRED
}

/// คำอธิบายก้อนโค้ดสำหรับผู้เริ่มต้น
/// กลุ่มสถานะ SubscriptionPaymentStatus: จำกัดค่าที่ฐานข้อมูลยอมรับ เพื่อไม่ให้บันทึกข้อความสถานะที่สะกดหรือมีความหมายไม่ตรงกัน
enum SubscriptionPaymentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

/// คำอธิบายก้อนโค้ดสำหรับผู้เริ่มต้น
/// กลุ่มสถานะ RoomStatus: จำกัดค่าที่ฐานข้อมูลยอมรับ เพื่อไม่ให้บันทึกข้อความสถานะที่สะกดหรือมีความหมายไม่ตรงกัน
enum RoomStatus {
  AVAILABLE
  OCCUPIED
