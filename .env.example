# คำอธิบายสำหรับผู้เริ่มต้น
# ภาพรวมไฟล์: เป็นรายการตัวแปรแวดล้อมตัวอย่างที่จำเป็นต่อการรัน Nestly โดยไม่มีรหัสลับจริง
# การทำงาน: คัดลอกเป็นไฟล์ .env สำหรับเครื่องพัฒนาแล้วใส่ค่าของสภาพแวดล้อมนั้น; ห้าม commit ไฟล์ .env ที่มีข้อมูลจริง

DATABASE_URL="postgresql://dorm_app:change-me@localhost:5432/dorm?schema=public"
# Integration/E2E must use a separate database whose name contains "test".
# DATABASE_URL="postgresql://dorm_test:change-me@localhost:5432/dorm_test?schema=public"
PLAYWRIGHT_BASE_URL="http://localhost:3000"
# Random secret of at least 32 characters used by the external cron scheduler.
JOB_SECRET=""
# Files are purged by the maintenance job. Business records remain available.
SLIP_RETENTION_DAYS="365"
DOCUMENT_RETENTION_DAYS="2555"
CHAT_ATTACHMENT_RETENTION_DAYS="365"
RETENTION_BATCH_SIZE="100"
# Owners can continue making changes for this many days after expiry.
# After this period the property workspace becomes read-only.
SUBSCRIPTION_GRACE_PERIOD_DAYS="7"
STORAGE_TYPE="local"
LOCAL_STORAGE_PATH="./storage/documents"
PUPPETEER_EXECUTABLE_PATH=""
APP_URL="http://localhost:3000"
# Password reset email provider (required in production).
RESEND_API_KEY=""
PASSWORD_RESET_EMAIL_FROM="Nestly <no-reply@example.com>"

# Required only when STORAGE_TYPE=s3
AWS_REGION="ap-southeast-1"
AWS_S3_BUCKET=""
AWS_S3_PREFIX="documents"

# One-time bootstrap command: npm run admin:bootstrap
BOOTSTRAP_ADMIN_EMAIL="owner@example.com"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-at-least-12-characters"
BOOTSTRAP_ADMIN_NAME="แอดมินใหญ่"
# Development only. Never enable this in production.
SHOW_DEMO_CREDENTIALS="false"
DEMO_PROPERTY_ADMIN_EMAIL="admin@example.com"
DEMO_PROPERTY_ADMIN_PASSWORD="replace-with-at-least-12-characters"
DEMO_PROPERTY_ADMIN_NAME="แอดมินหอทดลอง"
