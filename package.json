{
  "name": "nestly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:integration": "vitest run --config vitest.integration.config.ts --coverage",
    "test:e2e": "playwright test",
    "test:e2e:subscription": "node scripts/run-subscription-e2e.mjs",
    "test:e2e:mobile-touch": "node scripts/run-subscription-e2e.mjs tests/e2e/mobile-touch-target.spec.ts",
    "test:e2e:keyboard": "node scripts/run-subscription-e2e.mjs tests/e2e/keyboard-flows.spec.ts tests/e2e/accessibility-controls.spec.ts",
    "test:e2e:journeys": "playwright test tests/e2e/tenant-owner-journeys.spec.ts",
    "test:e2e:install": "playwright install chromium",
    "openapi:check": "node scripts/check-openapi.mjs",
    "openapi:sync": "node scripts/sync-openapi-v1.mjs",
    "docs:api": "node scripts/generate-api-reference.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "admin:bootstrap": "node scripts/bootstrap-super-admin.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "sonar:up": "docker compose -f docker-compose.sonarqube.yml up -d",
    "sonar:down": "docker compose -f docker-compose.sonarqube.yml down",
    "sonar:scan": "sonar-scanner-npm -Dsonar.host.url=http://localhost:9000",
    "sonar:report": "python3 scripts/sonar_report.py --host http://localhost:9000 --project nestly --token $SONAR_TOKEN"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "lucide-react": "^0.468.0",
    "next": "16.3.4",
    "ogl": "^1.0.11",
    "pg": "^8.22.0",
    "puppeteer": "^25.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.17.7",
    "sharp": "0.35.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prisma": "7.10.0",
    "sonarqube-scanner": "^5.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@hono/node-server": "^1.19.13",
    "brace-expansion": "5.0.9",
    "deepmerge-ts": "8.0.2",
    "fast-uri": "3.1.7",
    "js-yaml": "4.3.2",
    "minimatch": "10.2.6",
    "mysql2": "^3.24.4",
    "nanoid": "3.3.18",
    "postcss": "^8.5.18",
    "sharp": "$sharp"
  }
}
